# Copy this file to .env and fill in your real values. Never commit .env to git.

# Your Anthropic API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Which Claude model to use for the widget
CLAUDE_MODEL=claude-sonnet-4-6

# Port the backend server listens on
PORT=3001

# Comma-separated list of origins allowed to call this API (your live website domain(s)).
# Example: https://forgemedia.com,https://www.forgemedia.com
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Optional: a webhook URL (Zapier, Make, HubSpot form endpoint, etc.) that receives
# a POST whenever the agent captures a qualified lead (name/business/contact info).
# Leave blank to disable — leads will just be logged to the server console/file instead.
LEAD_WEBHOOK_URL=
